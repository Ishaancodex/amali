{
  "name": "amali-amenities-prototype",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "tsx scripts/tokens-to-css.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/tokens-to-css.ts && tsx scripts/check-tokens.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "images:map": "tsx scripts/map-amenity-images.ts",
    "tokens:css": "tsx scripts/tokens-to-css.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "i18next": "^24.2.1",
    "immer": "^10.1.1",
    "lucide-react": "^0.471.1",
    "motion": "^12.0.6",
    "nanoid": "^5.0.9",
    "next": "15.5.27",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^15.4.0",
    "recharts": "^2.15.0",
    "rrule": "^2.8.1",
    "seedrandom": "^3.0.5",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "lefthook": "^1.10.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.2"
  }
